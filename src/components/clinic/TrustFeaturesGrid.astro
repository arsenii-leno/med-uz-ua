---
import { defaultLocale, t, type Locale, type TranslationKey } from "../../lib/i18n";

export interface TrustFeatureItem {
  readonly titleKey: TranslationKey;
  readonly descKey: TranslationKey;
}

interface Props {
  readonly locale?: Locale;
  readonly items: readonly TrustFeatureItem[];
  readonly class?: string;
}

const {
  locale = defaultLocale,
  items,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "grid gap-5 sm:grid-cols-2 lg:grid-cols-4",
    className,
  ]}
  data-reveal
  data-reveal-sequence
>
  {items.map((item, index) => (
    <article class="flex flex-col justify-between rounded-2xl border border-[#f2ebd9] bg-[#faf6ee] p-6 shadow-[0_4px_20px_rgb(243,235,217,0.3)] transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-[1.01] hover:border-accent/40 hover:bg-[#faf5ea] hover:shadow-xl hover:shadow-accent/[0.04] sm:p-7">
      <div>
        <div class="flex items-center justify-between">
          <span class="font-sans text-xs font-bold tabular-nums tracking-widest text-primary/70">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
        </div>
        <h3 class="mt-4 font-serif text-xl font-medium leading-snug text-foreground">
          {t(locale, item.titleKey)}
        </h3>
        <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
          {t(locale, item.descKey)}
        </p>
      </div>
    </article>
  ))}
</div>
