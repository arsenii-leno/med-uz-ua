---
import { defaultLocale, t, type Locale, type TranslationKey } from "../../lib/i18n";

export interface FaqItem {
  readonly qKey: TranslationKey;
  readonly aKey: TranslationKey;
}

interface Props {
  readonly locale?: Locale;
  readonly eyebrowKey?: TranslationKey;
  readonly titleKey: TranslationKey;
  readonly faqs: readonly FaqItem[];
}

const {
  locale = defaultLocale,
  eyebrowKey,
  titleKey,
  faqs,
} = Astro.props;

const localizedFaqs = faqs.map((faq) => ({
  question: t(locale, faq.qKey),
  answer: t(locale, faq.aKey),
}));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": localizedFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

<section class="border-t border-border pt-16 sm:pt-20 lg:pt-24" aria-labelledby="faq-section-title" data-reveal>
  <div class="mx-auto max-w-3xl">
    <div class="text-center">
      {eyebrowKey && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3.5 py-1 text-xs font-bold tracking-wider text-primary uppercase">
          {t(locale, eyebrowKey)}
        </span>
      )}
      <h2
        id="faq-section-title"
        class="mt-3 font-serif text-3xl font-medium tracking-tight text-foreground sm:text-4xl"
      >
        {t(locale, titleKey)}
      </h2>
    </div>

    <div class="mt-10 space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group rounded-2xl border border-[#f2ebd9] bg-[#faf6ee]/80 p-5 shadow-[0_4px_20px_rgb(243,235,217,0.25)] transition-all duration-300 hover:border-accent/40 hover:bg-[#faf5ea] hover:shadow-md sm:p-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-foreground select-none">
            <span class="text-base font-medium leading-snug sm:text-lg group-hover:text-primary">
              {faq.question}
            </span>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-[#f2ebd9] bg-[#FDFBF7] text-primary transition-transform duration-300 group-open:rotate-180 group-hover:border-primary group-hover:bg-primary group-hover:text-primary-foreground">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 border-t border-[#f2ebd9] pt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
