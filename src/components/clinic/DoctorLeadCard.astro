---
import { clinicImageAssets } from "../../lib/assets";
import { chiefPhysician, clinicContact } from "../../lib/clinic";
import { defaultLocale, t, type Locale, type TranslationKey } from "../../lib/i18n";
import { getAppointmentHref } from "../../lib/navigation";

interface Props {
  readonly locale?: Locale;
  readonly approachKey: TranslationKey;
}

const { locale = defaultLocale, approachKey } = Astro.props;
const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);
const callAriaLabel = t(locale, "services.callAria", {
  phone: clinicContact.phoneDisplay,
});
---

<section
  class="overflow-hidden rounded-2xl border border-border/80 bg-card p-6 shadow-sm transition-all sm:p-10 lg:rounded-3xl lg:p-12"
  aria-labelledby="doctor-lead-heading"
  data-reveal
>
  <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
    <!-- Doctor Portrait Column -->
    <div class="relative mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none">
      <div class="group relative overflow-hidden rounded-2xl border border-border/80 bg-muted/40 shadow-xl shadow-primary/5 transition-all duration-500 hover:shadow-2xl hover:shadow-primary/10">
        <img
          class="aspect-[4/5] size-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          src={clinicImageAssets.doctorPortrait.src}
          width={clinicImageAssets.doctorPortrait.width}
          height={clinicImageAssets.doctorPortrait.height}
          alt={`${chiefPhysician.name} — ${t(locale, "doctor.role")}`}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="absolute -bottom-3 left-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow-xl sm:left-6">
        <span class="size-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
        <span>{t(locale, "doctor.badge")}</span>
      </div>
    </div>

    <!-- Doctor Information Column -->
    <div class="min-w-0 lg:col-span-7">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
        {t(locale, "about.doctorEyebrow")}
      </p>

      <h2
        id="doctor-lead-heading"
        class="mt-2 font-serif text-3xl font-medium tracking-tight text-primary sm:text-4xl lg:text-5xl"
      >
        {chiefPhysician.name}
      </h2>

      <p class="mt-1 font-serif text-base font-medium text-foreground/80 sm:text-lg">
        {t(locale, "doctor.role")}
      </p>

      <p class="mt-5 text-sm leading-relaxed text-muted-foreground sm:text-base sm:leading-7">
        {t(locale, approachKey)}
      </p>

      <!-- Key Clinical Standards List -->
      <ul class="mt-6 space-y-3 border-t border-border pt-6 text-sm text-foreground/90">
        <li class="flex items-center gap-3">
          <svg class="size-4.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          <span>{t(locale, "doctor.featureDiagnostics")}</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="size-4.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          <span>{t(locale, "doctor.featurePrescription")}</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="size-4.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          <span>{t(locale, "doctor.featureAttentive")}</span>
        </li>
      </ul>

      <!-- CTA Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          class="focus-ring-primary inline-flex min-h-12 items-center justify-center rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-md shadow-primary/15 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary/95 hover:shadow-lg active:translate-y-0"
          href={appointmentHref}
        >
          {t(locale, "actions.bookConsultation")}
        </a>
        <a
          class="focus-ring-primary inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-primary/25 bg-card px-6 text-sm font-semibold text-primary transition-all duration-200 hover:border-primary hover:bg-muted"
          href={clinicContact.phoneHref}
          aria-label={callAriaLabel}
        >
          <svg class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span>{clinicContact.phoneDisplay}</span>
        </a>
      </div>
    </div>
  </div>
</section>
