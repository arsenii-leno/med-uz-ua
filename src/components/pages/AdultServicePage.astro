---
import AppointmentForm from "../clinic/AppointmentForm.astro";
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DoctorLeadCard from "../clinic/DoctorLeadCard.astro";
import ServiceFaqAccordion, { type FaqItem } from "../clinic/ServiceFaqAccordion.astro";
import { clinicImageAssets } from "../../lib/assets";
import { clinicContact } from "../../lib/clinic";
import {
  defaultLocale,
  localizePath,
  t,
  type Locale,
} from "../../lib/i18n";
import { formatMedicalPrice } from "../../lib/medical-prices";
import { getAppointmentHref } from "../../lib/navigation";

interface Props {
  readonly locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);
const callAriaLabel = t(locale, "services.callAria", {
  phone: clinicContact.phoneDisplay,
});

const workflowStages = [
  { step: "01", titleKey: "adult.stage1Title", descKey: "adult.stage1Desc" },
  { step: "02", titleKey: "adult.stage2Title", descKey: "adult.stage2Desc" },
  { step: "03", titleKey: "adult.stage3Title", descKey: "adult.stage3Desc" },
  { step: "04", titleKey: "adult.stage4Title", descKey: "adult.stage4Desc" },
] as const;

const faqs: readonly FaqItem[] = [
  { qKey: "adult.faq1Q", aKey: "adult.faq1A" },
  { qKey: "adult.faq2Q", aKey: "adult.faq2A" },
  { qKey: "adult.faq3Q", aKey: "adult.faq3A" },
  { qKey: "adult.faq4Q", aKey: "adult.faq4A" },
];
---

<BaseLayout
  title={t(locale, "seo.adult.title")}
  description={t(locale, "seo.adult.description")}
  locale={locale}
  image={clinicImageAssets.adultExamination.src}
>
  <!-- Breadcrumbs -->
  <nav class="border-b border-[#f2ebd9] bg-[#FDFBF7]" aria-label={t(locale, "breadcrumbs.label")}>
    <Container>
      <ol class="flex min-h-14 items-center gap-2 text-xs font-medium text-muted-foreground sm:text-sm">
        <li>
          <a
            class="focus-ring-primary inline-flex min-h-11 items-center transition-colors hover:text-primary"
            href={localizePath("/", locale)}
          >
            {t(locale, "breadcrumbs.home")}
          </a>
        </li>
        <li aria-hidden="true" class="text-border">/</li>
        <li>
          <a
            class="focus-ring-primary inline-flex min-h-11 items-center transition-colors hover:text-primary"
            href={localizePath("/services", locale)}
          >
            {t(locale, "breadcrumbs.services")}
          </a>
        </li>
        <li aria-hidden="true" class="text-border">/</li>
        <li class="min-w-0">
          <span class="block truncate text-foreground" aria-current="page">
            {t(locale, "adult.heroEyebrow")}
          </span>
        </li>
      </ol>
    </Container>
  </nav>

  <!-- Hero Section -->
  <header class="bg-primary text-primary-foreground">
    <Container class="grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:items-center lg:gap-16 lg:py-24">
      <div class="min-w-0 lg:col-span-7" data-reveal>
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-accent">
          <span class="size-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
          {t(locale, "adult.heroEyebrow")}
        </span>

        <h1 class="mt-6 text-balance font-serif text-3xl font-medium leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
          {t(locale, "adult.heroTitle")}
        </h1>

        <p class="mt-6 max-w-2xl text-base font-light leading-relaxed text-primary-foreground/80 sm:text-lg">
          {t(locale, "adult.heroIntro")}
        </p>

        <!-- Diagnostic Package Highlight Box -->
        <div class="mt-8 rounded-2xl border border-primary-foreground/20 bg-primary-foreground/5 p-6 backdrop-blur-xs sm:p-7">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-accent/20 px-3 py-1 text-xs font-semibold tracking-wider text-accent uppercase">
              {t(locale, "adult.packageBadge")}
            </span>
            <span class="font-serif text-2xl font-bold tabular-nums text-accent sm:text-3xl">
              {t(locale, "adult.packagePrice")}
            </span>
          </div>
          <p class="mt-3 font-serif text-xl font-medium text-primary-foreground sm:text-2xl">
            {t(locale, "adult.packageTitle")}
          </p>
          <p class="mt-2 text-xs leading-relaxed text-primary-foreground/70 sm:text-sm">
            {t(locale, "adult.packageNote")}
          </p>
        </div>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            class="focus-ring-primary inline-flex min-h-13 items-center justify-center rounded-xl bg-accent px-7 text-sm font-semibold text-primary shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent/90 hover:shadow-lg active:translate-y-0"
            href={appointmentHref}
          >
            {t(locale, "actions.bookConsultation")}
          </a>

          <a
            class="focus-ring-primary inline-flex min-h-13 items-center justify-center gap-2 rounded-xl border border-primary-foreground/30 px-6 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:border-primary-foreground hover:bg-primary-foreground/10 active:translate-y-0"
            href={clinicContact.phoneHref}
            data-tracking-location="adult_service_hero"
            aria-label={callAriaLabel}
          >
            <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>{clinicContact.phoneDisplay}</span>
          </a>
        </div>
      </div>

      <!-- Photography Column -->
      <div class="relative min-w-0 lg:col-span-5" data-reveal>
        <figure class="group relative overflow-hidden rounded-2xl border border-primary-foreground/20 bg-muted/40 shadow-2xl transition-all duration-500 hover:shadow-primary/20 lg:rounded-3xl">
          <img
            class="aspect-[3/4] size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            src={clinicImageAssets.adultExamination.src}
            width={clinicImageAssets.adultExamination.width}
            height={clinicImageAssets.adultExamination.height}
            alt={t(locale, "adult.heroImageAlt")}
            loading="eager"
            decoding="async"
            sizes="(min-width: 1024px) 38vw, 100vw"
          />
          <figcaption class="absolute bottom-0 inset-x-0 bg-primary/90 p-4 text-xs tracking-wider uppercase text-primary-foreground/80 backdrop-blur-sm">
            {clinicContact.city} · {clinicContact.streetAddress}
          </figcaption>
        </figure>
      </div>
    </Container>
  </header>

  <!-- 4-Stage Examination Workflow -->
  <section class="bg-[#FDFBF7] py-16 sm:py-20 lg:py-28" aria-labelledby="workflow-heading">
    <Container>
      <div class="max-w-2xl" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "adult.workflowEyebrow")}
        </span>
        <h2 id="workflow-heading" class="mt-3 font-serif text-3xl font-medium tracking-tight text-foreground sm:text-4xl">
          {t(locale, "adult.workflowTitle")}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
          {t(locale, "adult.workflowIntro")}
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal data-reveal-sequence>
        {workflowStages.map((stage) => (
          <article class="relative flex flex-col justify-between rounded-2xl border border-[#f2ebd9] bg-[#faf6ee] p-6 shadow-[0_4px_20px_rgb(243,235,217,0.3)] transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-[1.01] hover:border-accent/40 hover:bg-[#faf5ea] hover:shadow-xl hover:shadow-accent/[0.04] sm:p-7">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-sans text-xs font-bold tabular-nums tracking-widest text-primary/70">
                  {stage.step}
                </span>
                <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
              </div>
              <h3 class="mt-4 font-serif text-xl font-medium leading-snug text-foreground">
                {t(locale, stage.titleKey)}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                {t(locale, stage.descKey)}
              </p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- Early Glaucoma & Cataract Screening Note -->
  <section class="border-y border-[#f2ebd9] bg-[#faf6ee] py-16 sm:py-20" aria-labelledby="glaucoma-heading">
    <Container>
      <div class="mx-auto max-w-4xl rounded-2xl border border-accent/25 bg-[#FDFBF7] p-8 shadow-[0_8px_30px_rgb(243,235,217,0.35)] sm:p-10 lg:p-12" data-reveal>
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary text-accent">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h2 id="glaucoma-heading" class="font-serif text-2xl font-medium text-foreground sm:text-3xl">
              {t(locale, "adult.glaucomaTitle")}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base sm:leading-7">
              {t(locale, "adult.glaucomaDesc")}
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Pricing Table Section -->
  <section class="bg-[#FDFBF7] py-16 sm:py-20 lg:py-28" aria-labelledby="pricing-heading">
    <Container>
      <div class="max-w-2xl" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "adult.pricingEyebrow")}
        </span>
        <h2 id="pricing-heading" class="mt-3 font-serif text-3xl font-medium tracking-tight text-foreground sm:text-4xl">
          {t(locale, "adult.pricingTitle")}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
          {t(locale, "adult.pricingIntro")}
        </p>
      </div>

      <div class="mt-10 overflow-hidden rounded-2xl border border-[#f2ebd9] bg-[#faf6ee] shadow-[0_4px_20px_rgb(243,235,217,0.25)]" data-reveal>
        <dl class="divide-y divide-[#f2ebd9]">
          <div class="grid items-baseline gap-2 p-5 sm:grid-cols-[1fr_auto] sm:p-6 transition-colors hover:bg-[#faf5ea]/80">
            <dt class="min-w-0">
              <span class="font-serif text-lg font-medium text-foreground sm:text-xl">
                {t(locale, "adult.packageTitle")}
              </span>
              <span class="mt-1 block text-xs text-muted-foreground sm:text-sm">
                {t(locale, "adult.packageNote")}
              </span>
            </dt>
            <dd class="font-serif text-xl font-bold tabular-nums text-primary sm:text-2xl">
              {t(locale, "adult.packagePrice")}
            </dd>
          </div>

          <div class="grid items-baseline gap-2 p-5 sm:grid-cols-[1fr_auto] sm:p-6 transition-colors hover:bg-[#faf5ea]/80">
            <dt class="min-w-0">
              <span class="font-serif text-lg font-medium text-foreground sm:text-xl">
                {t(locale, "services.itemChiefPhysician")}
              </span>
              <span class="mt-1 block text-xs text-muted-foreground sm:text-sm">
                {t(locale, "doctor.role")}
              </span>
            </dt>
            <dd class="font-serif text-xl font-bold tabular-nums text-primary sm:text-2xl">
              {formatMedicalPrice(800, locale)}
            </dd>
          </div>

          <div class="grid items-baseline gap-2 p-5 sm:grid-cols-[1fr_auto] sm:p-6 transition-colors hover:bg-[#faf5ea]/80">
            <dt class="min-w-0">
              <span class="font-serif text-lg font-medium text-foreground sm:text-xl">
                {t(locale, "services.itemAdult")} — {t(locale, "pediatric.itemFollowup").replace("дитячого ", "")}
              </span>
            </dt>
            <dd class="font-serif text-xl font-bold tabular-nums text-primary sm:text-2xl">
              {formatMedicalPrice(600, locale)}
            </dd>
          </div>

          <div class="grid items-baseline gap-2 p-5 sm:grid-cols-[1fr_auto] sm:p-6 transition-colors hover:bg-[#faf5ea]/80">
            <dt class="min-w-0">
              <span class="font-serif text-lg font-medium text-foreground sm:text-xl">
                {t(locale, "services.itemAutorefractometry")} (2 ока)
              </span>
            </dt>
            <dd class="font-serif text-xl font-bold tabular-nums text-primary sm:text-2xl">
              {formatMedicalPrice(200, locale)}
            </dd>
          </div>

          <div class="grid items-baseline gap-2 p-5 sm:grid-cols-[1fr_auto] sm:p-6 transition-colors hover:bg-[#faf5ea]/80">
            <dt class="min-w-0">
              <span class="font-serif text-lg font-medium text-foreground sm:text-xl">
                {t(locale, "services.itemVolk")} (2 ока)
              </span>
            </dt>
            <dd class="font-serif text-xl font-bold tabular-nums text-primary sm:text-2xl">
              {formatMedicalPrice(300, locale)}
            </dd>
          </div>
        </dl>
      </div>
    </Container>
  </section>

  <!-- Doctor Credibility Section -->
  <section class="border-t border-[#f2ebd9] bg-[#faf6ee] py-16 sm:py-20 lg:py-28" aria-label={t(locale, "about.doctorEyebrow")}>
    <Container>
      <DoctorLeadCard locale={locale} approachKey="doctor.adultApproach" />
    </Container>
  </section>

  <!-- FAQ Section with Schema.org JSON-LD -->
  <section class="border-t border-[#f2ebd9] bg-[#FDFBF7] py-16 sm:py-20 lg:py-28" aria-label={t(locale, "adult.faqTitle")}>
    <Container>
      <ServiceFaqAccordion
        locale={locale}
        eyebrowKey="adult.faqEyebrow"
        titleKey="adult.faqTitle"
        faqs={faqs}
      />
    </Container>
  </section>

  <!-- Final Booking Section with Integrated AppointmentForm -->
  <section
    id="appointment"
    class="scroll-mt-20 border-t border-[#f2ebd9] bg-[#faf6ee] py-20 sm:py-24 lg:py-32"
    aria-labelledby="adult-booking-title"
  >
    <Container class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
      <div class="min-w-0 lg:col-span-5 lg:pt-8" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "adult.finalEyebrow")}
        </span>
        <h2 id="adult-booking-title" class="mt-4 font-serif text-3xl font-medium leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          {t(locale, "adult.finalTitle")}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-muted-foreground">
          {t(locale, "adult.finalIntro")}
        </p>

        <div class="mt-8 border-t border-[#f2ebd9] pt-6">
          <p class="text-xs uppercase tracking-wider text-muted-foreground">
            {t(locale, "contacts.telephoneLabel")}:
          </p>
          <a
            class="mt-2 inline-flex items-center gap-2 font-serif text-xl font-semibold text-primary transition-colors hover:text-accent sm:text-2xl"
            href={clinicContact.phoneHref}
            data-tracking-location="adult_service_cta"
            aria-label={callAriaLabel}
          >
            <svg class="size-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>{clinicContact.phoneDisplay}</span>
          </a>
        </div>
      </div>

      <div class="min-w-0 lg:col-span-7 xl:pl-8">
        <AppointmentForm locale={locale} serviceType="adult" />
      </div>
    </Container>
  </section>
</BaseLayout>
