---
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  MEDICAL_PRICE_ITEMS,
  MEDICAL_PRICE_LIST_META,
} from "../../data/medical-prices";
import { getSpecializations } from "../../data/specializations";
import { clinicImageAssets } from "../../lib/assets";
import { chiefPhysician, clinicContact } from "../../lib/clinic";
import { localizePath, t, type Locale } from "../../lib/i18n";
import { getAppointmentHref } from "../../lib/navigation";
import {
  createMedicalPriceGroups,
  formatMedicalPrice,
  formatMedicalPriceApprovalDate,
  getMedicalServiceDisplayName,
  getMedicalServiceDisplayNote,
  usesOfficialUkrainianNameFallback,
} from "../../lib/medical-prices";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const SHOW_SPECIAL_PROGRAMS = true;

const callAriaLabel = t(locale, "services.callAria").replace(
  "{phone}",
  clinicContact.phoneDisplay,
);
const allMedicalPriceGroups = createMedicalPriceGroups(MEDICAL_PRICE_ITEMS);
const chiefConsultation = MEDICAL_PRICE_ITEMS.find(item => item.id === 1);
const medicalPriceGroups = allMedicalPriceGroups.map(group => ({
  ...group,
  items: group.items.filter(item => item.id !== 1)
})).filter(group => group.items.length > 0);

const premiumCopy = {
  uk: {
    badge: "Все включено • Без доплат",
    title: "Комплексний первинний огляд",
    subtitle: "Консультація головного лікаря. Включає повну апаратну діагностику зору.",
    includes: [
      "Комп'ютерна авторефрактометрія",
      "Перевірка гостроти зору (візометрія)",
      "Огляд на цифровій щілинній лампі",
      "Огляд очного дна (офтальмоскопія)",
      "Вимірювання очного тиску (з 40 років)",
      "Медичний висновок та базовий рецепт"
    ]
  },
  en: {
    badge: "All Inclusive • No Extra Fees",
    title: "Comprehensive Initial Examination",
    subtitle: "Chief Physician Consultation. Includes full hardware vision diagnostics.",
    includes: [
      "Computer autorefractometry",
      "Visual acuity test (visometry)",
      "Digital slit lamp examination",
      "Fundus examination (ophthalmoscopy)",
      "Intraocular pressure (age 40+)",
      "Medical conclusion & basic prescription"
    ]
  },
  sk: {
    badge: "Všetko v cene • Bez doplatkov",
    title: "Komplexné vstupné vyšetrenie",
    subtitle: "Konzultácia hlavného lekára. Zahŕňa kompletnú prístrojovú diagnostiku.",
    includes: [
      "Počítačová autorefraktometria",
      "Vyšetrenie zrakovej ostrosti",
      "Vyšetrenie na digitálnej štrbinovej lampe",
      "Vyšetrenie očného pozadia",
      "Meranie vnútroočného tlaku (40+)",
      "Lekárska správa a základný predpis"
    ]
  },
  hu: {
    badge: "Minden benne van • Nincs felár",
    title: "Átfogó első vizsgálat",
    subtitle: "Főorvosi konzultáció. Tartalmazza a teljes műszeres diagnosztikát.",
    includes: [
      "Számítógépes autorefraktometria",
      "Látásélesség vizsgálat",
      "Digitális réslámpa vizsgálat",
      "Szemfenék vizsgálat",
      "Szemnyomás mérés (40+)",
      "Orvosi vélemény és alap recept"
    ]
  }
};

const faqCopy = {
  uk: {
    title: "Часті запитання про вартість",
    q1: "Чи потрібно доплачувати за апаратне обстеження під час консультації?",
    a1: "Ні, уся базова комп'ютерна діагностика (авторефрактометрія, візометрія, біомікроскопія, офтальмоскопія, тонометрія) вже входить у вартість первинного прийому. Ви сплачуєте фіксовану ціну.",
    q2: "Для чого в прайсі вказані окремі ціни на діагностику?",
    a2: "Окремі ціни діють лише для ізольованих процедур — наприклад, якщо ви маєте направлення від іншого лікаря на конкретне обстеження або потребуєте повторного контролю одного показника.",
    q3: "Чи входить у вартість підбір корекції та рецепт?",
    a3: "Так, медичний висновок і базовий рецепт на окуляри входять у первинну консультацію. Складний підбір специфічних контактних лінз може оплачуватись додатково."
  },
  en: {
    title: "Frequently Asked Questions",
    q1: "Do I need to pay extra for hardware diagnostics during the consultation?",
    a1: "No, all basic computer diagnostics (autorefractometry, visometry, biomicroscopy, ophthalmoscopy, tonometry) are already included in the initial consultation price.",
    q2: "Why are diagnostics listed separately with their own prices?",
    a2: "Separate prices apply only to isolated procedures, such as when you have a referral from another doctor for a specific check-up.",
    q3: "Does the consultation include a prescription?",
    a3: "Yes, a medical conclusion and a basic glasses prescription are included. Complex fitting of specific contact lenses may be charged separately."
  },
  sk: {
    title: "Často kladené otázky",
    q1: "Musím doplácať za prístrojové vyšetrenie počas konzultácie?",
    a1: "Nie, celá základná počítačová diagnostika je už zahrnutá v cene vstupnej konzultácie. Platíte fixnú sumu.",
    q2: "Prečo sú v cenníku uvedené samostatné ceny za diagnostiku?",
    a2: "Samostatné ceny platia len pre izolované procedúry — napríklad ak máte výmenný lístok od iného lekára na konkrétne vyšetrenie.",
    q3: "Je v cene zahrnutý aj predpis na okuliare?",
    a3: "Áno, lekárska správa a základný predpis na okuliare sú zahrnuté vo vstupnej konzultácii."
  },
  hu: {
    title: "Gyakran Ismételt Kérdések",
    q1: "Külön kell fizetnem a műszeres diagnosztikáért a konzultáció során?",
    a1: "Nem, az összes alapvető számítógépes diagnosztika már benne van az első konzultáció árában.",
    q2: "Miért vannak külön feltüntetve a diagnosztikai árak?",
    a2: "A külön árak csak az elszigetelt eljárásokra vonatkoznak, például ha más orvostól van beutalója egy adott vizsgálatra.",
    q3: "A konzultáció tartalmazza a szemüvegfelírást is?",
    a3: "Igen, az orvosi vélemény és az alapvető szemüvegfelírás benne van a konzultációban."
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": faqCopy[locale].q1,
      "acceptedAnswer": { "@type": "Answer", "text": faqCopy[locale].a1 }
    },
    {
      "@type": "Question",
      "name": faqCopy[locale].q2,
      "acceptedAnswer": { "@type": "Answer", "text": faqCopy[locale].a2 }
    },
    {
      "@type": "Question",
      "name": faqCopy[locale].q3,
      "acceptedAnswer": { "@type": "Answer", "text": faqCopy[locale].a3 }
    }
  ]
};
const approvedOnDisplay = formatMedicalPriceApprovalDate(locale);
const showTranslationFallback = usesOfficialUkrainianNameFallback(locale);
const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);
const specializations = getSpecializations(locale);

const specializationCopy = {
  uk: {
    eyebrow: "Напрямки допомоги",
    title: "Клінічна увага та турбота про зір",
    intro:
      "Від первинного огляду немовлят і школярів до високої апаратної діагностики, зорової терапії та хірургічного супроводу.",
  },
  en: {
    eyebrow: "Clinical Care",
    title: "Dedicated Attention at Every Stage",
    intro:
      "From pediatric vision screening to advanced hardware diagnostics, vision therapy, and surgical care pathways.",
  },
  sk: {
    eyebrow: "Oblasti starostlivosti",
    title: "Klinická pozornosť v každej fáze",
    intro:
      "Od preventívnych vyšetrení detí po pokročilú prístrojovú diagnostiku, zrakovú terapiu a chirurgický manažment.",
  },
  hu: {
    eyebrow: "Szakterületek",
    title: "Szakértő gondoskodás minden szakaszban",
    intro:
      "A gyermekek látásvizsgálatától a korszerű műszeres szemészeti diagnosztikáig, látásterápiáig és sebészeti ellátásig.",
  },
} as const;
const specializationHeading = specializationCopy[locale];

const physicianCollageCopy = {
  uk: {
    eyebrow: "Головний лікар",
    title: chiefPhysician.name,
    badge: "Понад 20 років досвіду",
    role: "Засновниця та провідний лікар-офтальмолог",
    body: "Понад 20 років щоденної лікарської практики в офтальмології (з 2004 року). Поєднання академічного клінічного досвіду, сучасних європейських протоколів діагностики та щирої персональної турботи про зір кожного пацієнта.",
    feature1: "Експертна дитяча та доросла діагностика",
    feature2: "Складна оптична корекція та контроль міопії",
    feature3: "Індивідуальний супровід та консультації",
    portraitAlt: `${chiefPhysician.name}, головний лікар клініки`,
    contextAlt: "Мирослава Леньо під час консультативного прийому в кабінеті",
  },
  en: {
    eyebrow: "Chief Physician",
    title: chiefPhysician.name,
    badge: "Over 20 years of practice",
    role: "Founder & Lead Ophthalmologist",
    body: "More than 20 years of continuous clinical ophthalmology practice since 2004. Combining deep medical expertise, advanced European diagnostic standards, and attentive patient care.",
    feature1: "Expert pediatric and adult eye diagnostics",
    feature2: "Precision optical correction & myopia management",
    feature3: "Tailored treatment plan for every patient",
    portraitAlt: `${chiefPhysician.name}, Chief Physician`,
    contextAlt: "Dr. Miroslava Leno in the clinical office",
  },
  sk: {
    eyebrow: "Hlavná lekárka",
    title: chiefPhysician.name,
    badge: "Viac ako 20 rokov praxe",
    role: "Zakladateľka a vedúca oftalmologička",
    body: "Viac ako 20 rokov lekárskej praxe v oftalmológii (od roku 2004). Spojenie odbornej expertízy, moderných európskych diagnostických štandardov a osobného prístupu.",
    feature1: "Odborná detská a dospelá diagnostika",
    feature2: "Zložitá optická korekcia a kontrola krátkozrakosti",
    feature3: "Individuálny prístup ku každému pacientovi",
    portraitAlt: `${chiefPhysician.name}, hlavná lekárka`,
    contextAlt: "Dr. Miroslava Leno v ambulancii",
  },
  hu: {
    eyebrow: "Főorvos",
    title: chiefPhysician.name,
    badge: "Több mint 20 év tapasztalat",
    role: "Alapító és vezető szemészorvos",
    body: "Több mint 20 év folyamatos szemészeti gyakorlat (2004 óta). A szakmai tapasztalat, a modern európai diagnosztika és a páciensközpontú gondoskodás ötvözete.",
    feature1: "Szakértő gyermek- és felnőtt szemészeti vizsgálat",
    feature2: "Precíziós optikai korrekció és kezelés",
    feature3: "Személyre szabott terápiás terv",
    portraitAlt: `${chiefPhysician.name}, főorvos`,
    contextAlt: "Dr. Miroszlava Lényó a rendelőben",
  },
} as const;
const physicianCopy = physicianCollageCopy[locale];
---

<BaseLayout
  title={t(locale, "seo.services.title")}
  description={t(locale, "seo.services.description")}
  locale={locale}
>
  <!-- Hero Header -->
  <header class="border-b border-primary-foreground/15 bg-primary text-primary-foreground">
    <Container class="grid gap-10 py-16 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:py-24" data-reveal>
      <div class="lg:col-span-7">
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-accent">
          <span class="size-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
          {t(locale, "services.heroEyebrow")}
        </span>
        <h1 class="mt-6 text-balance font-serif text-4xl font-medium leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
          {t(locale, "services.heroTitle")}
        </h1>
      </div>

      <div class="flex flex-col justify-end border-t border-primary-foreground/20 pt-7 lg:col-span-5 lg:border-t-0 lg:border-l lg:border-primary-foreground/15 lg:pl-10 lg:pt-0">
        <p class="font-serif text-xl leading-relaxed text-primary-foreground/90 sm:text-2xl">
          {t(locale, "services.heroIntro")}
        </p>
        {SHOW_SPECIAL_PROGRAMS && (
          <a
            class="focus-ring-primary mt-6 inline-flex min-h-11 items-center border-b border-primary-foreground/40 text-sm font-semibold text-primary-foreground transition-colors hover:border-accent hover:text-accent"
            href={localizePath("/services/programs", locale)}
          >
            {t(locale, "services.programsLink")}
          </a>
        )}
      </div>
    </Container>
  </header>

  <!-- Три напрямки допомоги -->
  <section
    class="border-b border-[#f2ebd9] bg-[#FDFBF7] py-16 sm:py-20 lg:py-28"
    aria-labelledby="specializations-heading"
  >
    <Container>
      <div class="grid min-w-0 gap-8 lg:grid-cols-12 lg:items-end lg:gap-14" data-reveal>
        <div class="min-w-0 lg:col-span-8">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary/80">
            {specializationHeading.eyebrow}
          </p>
          <h2
            id="specializations-heading"
            class="mt-4 max-w-3xl font-serif text-3xl font-medium leading-tight tracking-[-0.025em] text-foreground sm:text-4xl lg:text-5xl"
          >
            {specializationHeading.title}
          </h2>
        </div>
        <p class="min-w-0 max-w-xl text-sm leading-7 text-foreground/70 sm:text-base lg:col-span-4">
          {specializationHeading.intro}
        </p>
      </div>

      <div class="mt-12 grid min-w-0 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
        {
          specializations.map((specialization, index) => {
            const cardHref = localizePath(specialization.href, locale);
            return (
              <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-[#f2ebd9] bg-[#faf6ee] shadow-[0_4px_20px_rgb(243,235,217,0.3)] transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-[1.01] hover:border-accent/40 hover:bg-[#faf5ea] hover:shadow-xl hover:shadow-accent/[0.04]">
                <figure class="relative aspect-[16/11] overflow-hidden bg-muted">
                  <img
                    class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    src={typeof specialization.image === "string" ? specialization.image : specialization.image.src}
                    width={specialization.image.width}
                    height={specialization.image.height}
                    alt={specialization.imageAlt}
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                  <span class="absolute left-4 top-4 inline-flex items-center rounded bg-primary/90 px-2.5 py-1 text-xs font-semibold tabular-nums tracking-wider text-accent backdrop-blur-sm">
                    0{index + 1}
                  </span>
                </figure>

                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="font-serif text-xl font-medium leading-snug text-foreground sm:text-2xl">
                    <a
                      href={cardHref}
                      class="focus-ring-primary transition-colors hover:text-primary after:absolute after:inset-0 after:z-10"
                    >
                      {specialization.title}
                    </a>
                  </h3>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-foreground/70">
                    {specialization.description}
                  </p>

                  <div class="mt-6 border-t border-[#f2ebd9] pt-4">
                    <span
                      class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-primary transition-all duration-300 group-hover:text-accent group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      <span>{t(locale, "actions.learnMore")}</span>
                      <svg class="size-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </Container>
  </section>

  <!-- Секція головного лікаря -->
  <section class="border-b border-[#f2ebd9] bg-[#faf6ee] py-16 sm:py-20 lg:py-28" aria-labelledby="services-physician-heading">
    <Container class="grid min-w-0 gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <!-- Фотокомпозиція з бейджем -->
      <div class="relative min-w-0 max-w-md mx-auto lg:max-w-none lg:col-span-5" data-reveal>
        <figure class="overflow-hidden rounded-2xl border border-[#f2ebd9] bg-white shadow-xl shadow-primary/5 transition-all duration-500 hover:border-accent/40 hover:shadow-2xl">
          <img
            class="aspect-[4/5] size-full object-cover object-top"
            src={clinicImageAssets.doctorPortrait.src}
            width={clinicImageAssets.doctorPortrait.width}
            height={clinicImageAssets.doctorPortrait.height}
            alt={physicianCopy.portraitAlt}
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="absolute -bottom-4 left-6 inline-flex items-center gap-2.5 rounded-full border border-primary/20 bg-primary px-5 py-2 text-xs font-semibold text-primary-foreground shadow-xl">
          <span class="size-2 rounded-full bg-accent animate-pulse" />
          <span>{physicianCopy.badge}</span>
        </div>
      </div>

      <!-- Інформаційний блок -->
      <div class="min-w-0 lg:col-span-7 lg:pl-6" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
          {physicianCopy.eyebrow}
        </p>
        <h2 id="services-physician-heading" class="mt-3 font-serif text-3xl font-medium tracking-tight text-primary sm:text-4xl lg:text-5xl">
          {physicianCopy.title}
        </h2>
        <p class="mt-1 text-sm font-semibold text-foreground/70">
          {physicianCopy.role}
        </p>

        <p class="mt-6 text-sm leading-7 text-foreground/80 sm:text-base sm:leading-8">
          {physicianCopy.body}
        </p>

        <!-- Переваги / Напрямки лікаря -->
        <ul class="mt-6 space-y-2.5 border-t border-[#f2ebd9] pt-6">
          <li class="flex items-center gap-3 text-sm text-foreground/85">
            <svg class="size-4.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{physicianCopy.feature1}</span>
          </li>
          <li class="flex items-center gap-3 text-sm text-foreground/85">
            <svg class="size-4.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{physicianCopy.feature2}</span>
          </li>
          <li class="flex items-center gap-3 text-sm text-foreground/85">
            <svg class="size-4.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{physicianCopy.feature3}</span>
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            class="focus-ring-primary inline-flex min-h-12 items-center justify-center rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary/95 hover:shadow-lg active:translate-y-0"
            href={appointmentHref}
          >
            {t(locale, "actions.bookConsultation")}
          </a>
          <a
            class="focus-ring-primary inline-flex min-h-12 items-center justify-center rounded-xl border border-[#f2ebd9] bg-[#FDFBF7] px-6 text-sm font-semibold text-primary transition-all duration-200 hover:border-accent/40 hover:bg-[#faf5ea]"
            href={clinicContact.phoneHref}
            data-tracking-location="services_hero"
            aria-label={callAriaLabel}
          >
            {clinicContact.phoneDisplay}
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Прайс-лист: Повнорозмірний смарагдовий банер -->
  <section class="border-y border-primary-foreground/15 bg-primary py-12 sm:py-16 text-primary-foreground" aria-labelledby="price-list-heading">
    <Container data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
        {t(locale, "services.listEyebrow")}
      </p>
      <h2
        id="price-list-heading"
        class="mt-2 font-serif text-3xl font-medium tracking-tight text-primary-foreground sm:text-4xl lg:text-5xl"
      >
        {t(locale, "services.listTitle")}
      </h2>
    </Container>
  </section>

  <!-- Прайс-лист: Каталог послуг на теплому фоні Ivory -->
  <section class="border-b border-[#f2ebd9] bg-[#FDFBF7] py-16 sm:py-20 lg:py-28" aria-label={t(locale, "services.listTitle")}>
    <Container>
      {
        showTranslationFallback && (
          <p class="mb-10 max-w-3xl border-l-2 border-accent pl-4 text-sm leading-6 text-foreground/70">
            {t(locale, "services.translationFallbackNote")}
          </p>
        )
      }

      
      {/* Флагманський блок головного лікаря */}
      {chiefConsultation && (
        <div class="mb-12 overflow-hidden rounded-2xl border border-[#f2ebd9] bg-[#faf6ee] shadow-[0_8px_30px_rgb(243,235,217,0.35)] ring-1 ring-accent/15 sm:p-10 p-6 lg:flex lg:items-center lg:gap-12" data-reveal>
          <div class="flex-1">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent">
              <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {premiumCopy[locale].badge}
            </span>
            <h3 class="mt-4 font-serif text-2xl font-medium tracking-tight text-primary sm:text-3xl">
              {premiumCopy[locale].title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-foreground/70 sm:text-base">
              {premiumCopy[locale].subtitle}
            </p>
            <ul class="mt-6 grid gap-x-6 gap-y-3 sm:grid-cols-2 text-sm text-foreground/80">
              {premiumCopy[locale].includes.map(inc => (
                <li class="flex items-start gap-3">
                  <svg class="mt-0.5 size-4 shrink-0 text-accent/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-8 border-t border-[#f2ebd9] pt-8 lg:mt-0 lg:shrink-0 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
            <div class="text-center lg:text-left">
              <p class="text-3xl font-bold tabular-nums text-primary">{formatMedicalPrice(chiefConsultation?.priceUah ?? 800, locale)}</p>
              <a href={appointmentHref} class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-primary px-8 text-sm font-semibold text-primary-foreground shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary/95 hover:shadow-lg active:translate-y-0">
                {t(locale, "actions.bookConsultation")}
              </a>
            </div>
          </div>
        </div>
      )}

      <div class="min-w-0 divide-y divide-[#f2ebd9]">
        {
          medicalPriceGroups.map((group, groupIndex) => (
            <section
              class="grid gap-7 py-10 sm:py-12 lg:grid-cols-12 lg:gap-12"
              aria-labelledby={`service-group-${groupIndex}`}
              data-reveal
            >
              <div class="lg:col-span-4">
                <p class="text-xs font-semibold tabular-nums tracking-[0.18em] text-primary/70">
                  {String(groupIndex + 1).padStart(2, "0")}
                </p>
                <h3
                  id={`service-group-${groupIndex}`}
                  class="mt-3 max-w-sm font-serif text-2xl font-medium leading-tight text-primary sm:text-3xl"
                >
                  {t(locale, group.titleKey)}
                </h3>
              </div>

              <dl class="divide-y divide-[#f2ebd9] border-t border-[#f2ebd9] lg:col-span-8">
                {group.items.map((item) => (
                  <div
                    data-medical-price-id={item.id}
                    class="group grid min-w-0 gap-2 py-4.5 transition-colors hover:bg-[#faf5ea]/80 px-3 -mx-3 rounded-lg sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8"
                  >
                    <dt class="min-w-0 text-sm font-medium leading-6 text-foreground sm:text-base">
                      <span class="flex min-w-0 items-baseline gap-3">
                        <span
                          class="shrink-0 text-[0.6875rem] font-semibold tabular-nums tracking-[0.12em] text-primary/60"
                          aria-hidden="true"
                        >
                          #{String(item.id).padStart(2, "0")}
                        </span>
                        <span class="min-w-0 break-words group-hover:text-primary transition-colors">
                          {getMedicalServiceDisplayName(item, locale)}
                        </span>
                      </span>
                      {
                        getMedicalServiceDisplayNote(item, locale) && (
                          <span class="mt-1 block break-words pl-8 text-xs font-normal leading-5 text-foreground/70">
                            {getMedicalServiceDisplayNote(item, locale)}
                          </span>
                        )
                      }
                    </dt>
                    <dd class="whitespace-nowrap pl-8 text-sm font-bold leading-6 tabular-nums text-primary sm:pl-0 sm:text-right sm:text-base">
                      <span class="sr-only">{t(locale, "services.priceLabel")}: </span>
                      {formatMedicalPrice(item.priceUah, locale)}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          ))
        }
      </div>

      <aside
        class="mt-8 grid gap-8 border-y border-[#f2ebd9] py-8 sm:py-10 lg:grid-cols-12 lg:gap-12"
        aria-labelledby="price-list-source-heading"
      >
        <div class="lg:col-span-4">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary/80">
            {t(locale, "services.sourceEyebrow")}
          </p>
          <h3
            id="price-list-source-heading"
            class="mt-3 max-w-sm font-serif text-xl font-medium leading-tight text-foreground sm:text-2xl"
          >
            {t(locale, "services.sourceTitle")}
          </h3>
        </div>

        <div class="min-w-0 lg:col-span-8">
          <dl class="grid min-w-0 gap-x-8 gap-y-6 sm:grid-cols-2">
            <div class="min-w-0">
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70">
                {t(locale, "services.approvedOnLabel")}
              </dt>
              <dd class="mt-2 text-sm leading-6 text-foreground">
                <time datetime={MEDICAL_PRICE_LIST_META.approvedOn}>
                  {approvedOnDisplay}
                </time>
              </dd>
            </div>
            <div class="min-w-0">
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70">
                {t(locale, "services.currencyLabel")}
              </dt>
              <dd class="mt-2 text-sm leading-6 text-foreground">
                {MEDICAL_PRICE_LIST_META.currency}
              </dd>
            </div>
            <div class="min-w-0">
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70">
                {t(locale, "services.legalEntityLabel")}
              </dt>
              <dd class="mt-2 break-words text-sm leading-6 text-foreground">
                {MEDICAL_PRICE_LIST_META.legalEntity}
              </dd>
            </div>
            <div class="min-w-0">
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70">
                {t(locale, "services.officialAddressLabel")}
              </dt>
              <dd class="mt-2 break-words text-sm leading-6 text-foreground">
                {MEDICAL_PRICE_LIST_META.officialAddress}
              </dd>
            </div>
          </dl>
        </div>
      </aside>

      {/* FAQ Section: Інтерактивний акордеон */}
      <section class="mt-16 border-t border-[#f2ebd9] pt-16 sm:mt-20 sm:pt-20" aria-labelledby="faq-heading" data-reveal>
        <div class="mx-auto max-w-3xl">
          <div class="text-center mb-10">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3.5 py-1 text-xs font-bold tracking-wider text-primary uppercase">
              Прозорість цін
            </span>
            <h3 id="faq-heading" class="mt-3 font-serif text-2xl font-semibold tracking-tight text-primary sm:text-3xl">
              {faqCopy[locale].title}
            </h3>
          </div>

          <div class="space-y-4">
            {[
              { q: faqCopy[locale].q1, a: faqCopy[locale].a1 },
              { q: faqCopy[locale].q2, a: faqCopy[locale].a2 },
              { q: faqCopy[locale].q3, a: faqCopy[locale].a3 },
            ].map((faq) => (
              <details class="group rounded-2xl border border-[#f2ebd9] bg-[#faf6ee]/80 p-5 shadow-[0_4px_20px_rgb(243,235,217,0.25)] transition-all duration-300 hover:border-accent/40 hover:bg-[#faf5ea] hover:shadow-md sm:p-6">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-primary transition-colors select-none">
                  <span class="text-base sm:text-lg font-bold leading-snug group-hover:text-primary">
                    {faq.q}
                  </span>
                  <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-[#f2ebd9] bg-[#FDFBF7] text-primary transition-transform duration-300 group-open:rotate-180 group-hover:border-primary group-hover:bg-primary group-hover:text-white">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </span>
                </summary>
                <div class="mt-4 border-t border-[#f2ebd9] pt-4 text-sm leading-relaxed text-foreground/80 sm:text-base">
                  <p>{faq.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
        <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      </section>
    </Container>
  </section>

  <!-- Заклик до дії -->
  <section class="bg-primary py-16 text-primary-foreground sm:py-20" aria-labelledby="services-action-heading">
    <Container class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">
          {t(locale, "services.nextEyebrow")}
        </p>
        <h2
          id="services-action-heading"
          class="mt-4 max-w-2xl font-serif text-balance text-3xl font-medium tracking-tight sm:text-4xl"
        >
          {t(locale, "services.nextTitle")}
        </h2>
        <p class="mt-5 max-w-xl text-sm leading-6 text-primary-foreground/75">
          {t(locale, "services.shopPrompt")}{" "}
          <a
            class="border-b border-primary-foreground/35 font-semibold text-primary-foreground transition-colors hover:border-accent hover:text-accent"
            href={localizePath("/shop", locale)}
          >
            {t(locale, "services.shopLink")}
          </a>
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:col-span-5 lg:justify-end">
        <a
          class="focus-ring-primary inline-flex min-h-12 items-center justify-center bg-primary-foreground px-6 text-sm font-semibold text-primary transition-colors hover:bg-accent hover:text-foreground"
          href={appointmentHref}
        >
          {t(locale, "services.book")}
        </a>
        <a
          class="inline-flex min-h-12 items-center justify-center border border-primary-foreground/45 px-6 text-sm font-semibold text-primary-foreground transition-colors hover:border-accent hover:text-accent"
          href={clinicContact.phoneHref}
          data-tracking-location="services_cta"
          aria-label={callAriaLabel}
        >
          {t(locale, "services.call")}
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
