---
import AppointmentForm from "../clinic/AppointmentForm.astro";
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DoctorLeadCard from "../clinic/DoctorLeadCard.astro";
import ServiceFaqAccordion, { type FaqItem } from "../clinic/ServiceFaqAccordion.astro";
import { clinicImageAssets } from "../../lib/assets";
import { clinicContact } from "../../lib/clinic";
import {
  defaultLocale,
  localizePath,
  t,
  type Locale,
} from "../../lib/i18n";
import { getAppointmentHref } from "../../lib/navigation";

interface Props {
  readonly locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);
const callAriaLabel = t(locale, "services.callAria", {
  phone: clinicContact.phoneDisplay,
});

const indications = [
  { titleKey: "programs.ind1Title", descKey: "programs.ind1Desc" },
  { titleKey: "programs.ind2Title", descKey: "programs.ind2Desc" },
  { titleKey: "programs.ind3Title", descKey: "programs.ind3Desc" },
  { titleKey: "programs.ind4Title", descKey: "programs.ind4Desc" },
] as const;

const courseSteps = [
  { step: "01", titleKey: "programs.step1Title", descKey: "programs.step1Desc" },
  { step: "02", titleKey: "programs.step2Title", descKey: "programs.step2Desc" },
  { step: "03", titleKey: "programs.step3Title", descKey: "programs.step3Desc" },
  { step: "04", titleKey: "programs.step4Title", descKey: "programs.step4Desc" },
] as const;

const faqs: readonly FaqItem[] = [
  { qKey: "programs.faq1Q", aKey: "programs.faq1A" },
  { qKey: "programs.faq2Q", aKey: "programs.faq2A" },
  { qKey: "programs.faq3Q", aKey: "programs.faq3A" },
  { qKey: "programs.faq4Q", aKey: "programs.faq4A" },
];
---

<BaseLayout
  title={t(locale, "seo.programs.title")}
  description={t(locale, "seo.programs.description")}
  locale={locale}
  image={clinicImageAssets.doctorInCabinet.src}
>
  <!-- Breadcrumbs -->
  <nav class="border-b border-border bg-background" aria-label={t(locale, "breadcrumbs.label")}>
    <Container>
      <ol class="flex min-h-14 items-center gap-2 text-xs font-medium text-muted-foreground sm:text-sm">
        <li>
          <a
            class="focus-ring-primary inline-flex min-h-11 items-center transition-colors hover:text-primary"
            href={localizePath("/", locale)}
          >
            {t(locale, "breadcrumbs.home")}
          </a>
        </li>
        <li aria-hidden="true" class="text-border">/</li>
        <li>
          <a
            class="focus-ring-primary inline-flex min-h-11 items-center transition-colors hover:text-primary"
            href={localizePath("/services", locale)}
          >
            {t(locale, "breadcrumbs.services")}
          </a>
        </li>
        <li aria-hidden="true" class="text-border">/</li>
        <li class="min-w-0">
          <span class="block truncate text-foreground" aria-current="page">
            {t(locale, "programs.therapyEyebrow")}
          </span>
        </li>
      </ol>
    </Container>
  </nav>

  <!-- Hero Section -->
  <header class="bg-primary text-primary-foreground">
    <Container class="grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:items-center lg:gap-16 lg:py-24">
      <div class="min-w-0 lg:col-span-7" data-reveal>
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-accent">
          <span class="size-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
          {t(locale, "programs.therapyEyebrow")}
        </span>

        <h1 class="mt-6 text-balance font-serif text-3xl font-medium leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
          {t(locale, "programs.therapyTitle")}
        </h1>

        <p class="mt-6 max-w-2xl text-base font-light leading-relaxed text-primary-foreground/80 sm:text-lg">
          {t(locale, "programs.therapyIntro")}
        </p>

        <!-- Social & Veteran Care Announcement -->
        <div class="mt-8 rounded-2xl border border-primary-foreground/20 bg-primary-foreground/5 p-5 backdrop-blur-xs sm:p-6">
          <div class="flex items-start gap-3.5">
            <svg class="size-6 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-accent">
                {t(locale, "programs.socialTitle")}
              </p>
              <p class="mt-1 text-xs leading-relaxed text-primary-foreground/85 sm:text-sm">
                {t(locale, "programs.socialDesc")}
              </p>
            </div>
          </div>
        </div>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            class="focus-ring-primary inline-flex min-h-13 items-center justify-center rounded-xl bg-accent px-7 text-sm font-semibold text-primary shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent/90 hover:shadow-lg active:translate-y-0"
            href={appointmentHref}
          >
            {t(locale, "actions.bookConsultation")}
          </a>

          <a
            class="focus-ring-primary inline-flex min-h-13 items-center justify-center gap-2 rounded-xl border border-primary-foreground/30 px-6 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:border-primary-foreground hover:bg-primary-foreground/10 active:translate-y-0"
            href={clinicContact.phoneHref}
            aria-label={callAriaLabel}
          >
            <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>{clinicContact.phoneDisplay}</span>
          </a>
        </div>
      </div>

      <!-- Photography Column -->
      <div class="relative min-w-0 lg:col-span-5" data-reveal>
        <figure class="group relative overflow-hidden rounded-2xl border border-primary-foreground/20 bg-muted/40 shadow-2xl transition-all duration-500 hover:shadow-primary/20 lg:rounded-3xl">
          <img
            class="aspect-[4/3] size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            src={clinicImageAssets.doctorInCabinet.src}
            width={clinicImageAssets.doctorInCabinet.width}
            height={clinicImageAssets.doctorInCabinet.height}
            alt={t(locale, "programs.heroImageAlt")}
            loading="eager"
            decoding="async"
            sizes="(min-width: 1024px) 38vw, 100vw"
          />
          <figcaption class="absolute bottom-0 inset-x-0 bg-primary/90 p-4 text-xs tracking-wider uppercase text-primary-foreground/80 backdrop-blur-sm">
            {clinicContact.city} · {clinicContact.streetAddress}
          </figcaption>
        </figure>
      </div>
    </Container>
  </header>

  <!-- Indications Section (Who needs vision therapy) -->
  <section class="bg-background py-16 sm:py-20 lg:py-28" aria-labelledby="indications-heading">
    <Container>
      <div class="max-w-2xl" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "programs.indicationsEyebrow")}
        </span>
        <h2 id="indications-heading" class="mt-3 font-serif text-3xl font-medium tracking-tight text-foreground sm:text-4xl">
          {t(locale, "programs.indicationsTitle")}
        </h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-2" data-reveal data-reveal-sequence>
        {indications.map((item) => (
          <article class="flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-xs transition-all duration-300 hover:border-primary/40 hover:shadow-md sm:p-8">
            <div>
              <div class="flex items-center gap-2">
                <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
                <span class="text-xs font-semibold tracking-wider uppercase text-primary">
                  {t(locale, "serviceDetail.clinicalEyebrow")}
                </span>
              </div>
              <h3 class="mt-4 font-serif text-xl font-medium leading-snug text-foreground sm:text-2xl">
                {t(locale, item.titleKey)}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
                {t(locale, item.descKey)}
              </p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- 4-Step Course Structure -->
  <section class="border-y border-border bg-card py-16 sm:py-20 lg:py-28" aria-labelledby="course-heading">
    <Container>
      <div class="max-w-2xl" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "programs.courseEyebrow")}
        </span>
        <h2 id="course-heading" class="mt-3 font-serif text-3xl font-medium tracking-tight text-foreground sm:text-4xl">
          {t(locale, "programs.courseTitle")}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
          {t(locale, "programs.courseDesc")}
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal data-reveal-sequence>
        {courseSteps.map((step) => (
          <article class="relative flex flex-col justify-between rounded-2xl border border-border/80 bg-background p-6 shadow-xs transition-all duration-300 hover:border-primary/40 hover:shadow-md sm:p-7">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-sans text-xs font-bold tabular-nums tracking-widest text-primary/70">
                  {step.step}
                </span>
                <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
              </div>
              <h3 class="mt-4 font-serif text-xl font-medium leading-snug text-foreground">
                {t(locale, step.titleKey)}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                {t(locale, step.descKey)}
              </p>
            </div>
          </article>
        ))}
      </div>

      <!-- Pricing Transparency Note -->
      <div class="mt-10 rounded-2xl border border-primary/20 bg-muted/40 p-6 text-sm leading-relaxed text-muted-foreground sm:p-8" data-reveal>
        <p class="font-medium text-foreground">
          {t(locale, "programs.pricingNote")}
        </p>
      </div>
    </Container>
  </section>

  <!-- Doctor Credibility Section -->
  <section class="border-b border-border bg-muted/30 py-16 sm:py-20 lg:py-28" aria-label={t(locale, "about.doctorEyebrow")}>
    <Container>
      <DoctorLeadCard locale={locale} approachKey="doctor.programsApproach" />
    </Container>
  </section>

  <!-- FAQ Section with Schema.org JSON-LD -->
  <section class="border-b border-border bg-background py-16 sm:py-20 lg:py-28" aria-label={t(locale, "programs.faqTitle")}>
    <Container>
      <ServiceFaqAccordion
        locale={locale}
        eyebrowKey="programs.faqEyebrow"
        titleKey="programs.faqTitle"
        faqs={faqs}
      />
    </Container>
  </section>

  <!-- Final Booking Section with Integrated AppointmentForm -->
  <section
    id="appointment"
    class="scroll-mt-20 bg-muted/40 py-20 sm:py-24 lg:py-32"
    aria-labelledby="programs-booking-title"
  >
    <Container class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
      <div class="min-w-0 lg:col-span-5 lg:pt-8" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "programs.finalEyebrow")}
        </span>
        <h2 id="programs-booking-title" class="mt-4 font-serif text-3xl font-medium leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          {t(locale, "programs.finalTitle")}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-muted-foreground">
          {t(locale, "programs.finalIntro")}
        </p>

        <div class="mt-8 border-t border-border pt-6">
          <p class="text-xs uppercase tracking-wider text-muted-foreground">
            {t(locale, "contacts.telephoneLabel")}:
          </p>
          <a
            class="mt-2 inline-flex items-center gap-2 font-serif text-xl font-semibold text-primary transition-colors hover:text-accent sm:text-2xl"
            href={clinicContact.phoneHref}
            aria-label={callAriaLabel}
          >
            <svg class="size-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>{clinicContact.phoneDisplay}</span>
          </a>
        </div>
      </div>

      <div class="min-w-0 lg:col-span-7 xl:pl-8">
        <AppointmentForm locale={locale} />
      </div>
    </Container>
  </section>
</BaseLayout>
