---
import AppointmentForm from "../clinic/AppointmentForm.astro";
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DoctorLeadCard from "../clinic/DoctorLeadCard.astro";
import ServiceFaqAccordion, { type FaqItem } from "../clinic/ServiceFaqAccordion.astro";
import TrustFeaturesGrid, { type TrustFeatureItem } from "../clinic/TrustFeaturesGrid.astro";
import { clinicImageAssets } from "../../lib/assets";
import { clinicContact } from "../../lib/clinic";
import {
  defaultLocale,
  localizePath,
  t,
  type Locale,
} from "../../lib/i18n";
import { formatMedicalPrice } from "../../lib/medical-prices";
import { getAppointmentHref } from "../../lib/navigation";

interface Props {
  readonly locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);
const callAriaLabel = t(locale, "services.callAria", {
  phone: clinicContact.phoneDisplay,
});

const trustItems: readonly TrustFeatureItem[] = [
  { titleKey: "pediatric.trust1Title", descKey: "pediatric.trust1Desc" },
  { titleKey: "pediatric.trust2Title", descKey: "pediatric.trust2Desc" },
  { titleKey: "pediatric.trust3Title", descKey: "pediatric.trust3Desc" },
  { titleKey: "pediatric.trust4Title", descKey: "pediatric.trust4Desc" },
];

const faqs: readonly FaqItem[] = [
  { qKey: "pediatric.faq1Q", aKey: "pediatric.faq1A" },
  { qKey: "pediatric.faq2Q", aKey: "pediatric.faq2A" },
  { qKey: "pediatric.faq3Q", aKey: "pediatric.faq3A" },
  { qKey: "pediatric.faq4Q", aKey: "pediatric.faq4A" },
  { qKey: "pediatric.faq5Q", aKey: "pediatric.faq5A" },
];
---

<BaseLayout
  title={t(locale, "seo.pediatric.title")}
  description={t(locale, "seo.pediatric.description")}
  locale={locale}
  image={clinicImageAssets.pediatricExamination.src}
>
  <!-- Breadcrumbs -->
  <nav class="border-b border-border bg-background" aria-label={t(locale, "breadcrumbs.label")}>
    <Container>
      <ol class="flex min-h-14 items-center gap-2 text-xs font-medium text-muted-foreground sm:text-sm">
        <li>
          <a
            class="focus-ring-primary inline-flex min-h-11 items-center transition-colors hover:text-primary"
            href={localizePath("/", locale)}
          >
            {t(locale, "breadcrumbs.home")}
          </a>
        </li>
        <li aria-hidden="true" class="text-border">/</li>
        <li>
          <a
            class="focus-ring-primary inline-flex min-h-11 items-center transition-colors hover:text-primary"
            href={localizePath("/services", locale)}
          >
            {t(locale, "breadcrumbs.services")}
          </a>
        </li>
        <li aria-hidden="true" class="text-border">/</li>
        <li class="min-w-0">
          <span class="block truncate text-foreground" aria-current="page">
            {t(locale, "pediatric.heroEyebrow")}
          </span>
        </li>
      </ol>
    </Container>
  </nav>

  <!-- Hero Section -->
  <header class="bg-primary text-primary-foreground">
    <Container class="grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:items-center lg:gap-16 lg:py-24">
      <div class="min-w-0 lg:col-span-7" data-reveal>
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-accent">
          <span class="size-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
          {t(locale, "pediatric.heroEyebrow")}
        </span>

        <h1 class="mt-6 text-balance font-serif text-3xl font-medium leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
          {t(locale, "pediatric.heroTitle")}
        </h1>

        <p class="mt-6 max-w-2xl text-base font-light leading-relaxed text-primary-foreground/80 sm:text-lg">
          {t(locale, "pediatric.heroIntro")}
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            class="focus-ring-primary inline-flex min-h-13 items-center justify-center rounded-xl bg-accent px-7 text-sm font-semibold text-primary shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent/90 hover:shadow-lg active:translate-y-0"
            href={appointmentHref}
          >
            {t(locale, "pediatric.bookCta")}
          </a>

          <a
            class="focus-ring-primary inline-flex min-h-13 items-center justify-center gap-2 rounded-xl border border-primary-foreground/30 px-6 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:border-primary-foreground hover:bg-primary-foreground/10 active:translate-y-0"
            href={clinicContact.phoneHref}
            aria-label={callAriaLabel}
          >
            <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>{clinicContact.phoneDisplay}</span>
          </a>
        </div>
      </div>

      <!-- Authentic Clinic Photography -->
      <div class="relative min-w-0 lg:col-span-5" data-reveal>
        <figure class="group relative overflow-hidden rounded-2xl border border-primary-foreground/20 bg-muted/40 shadow-2xl transition-all duration-500 hover:shadow-primary/20 lg:rounded-3xl">
          <img
            class="aspect-[4/3] size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            src={clinicImageAssets.pediatricExamination.src}
            width={clinicImageAssets.pediatricExamination.width}
            height={clinicImageAssets.pediatricExamination.height}
            alt={t(locale, "pediatric.heroImageAlt")}
            loading="eager"
            decoding="async"
            sizes="(min-width: 1024px) 42vw, 100vw"
          />
          <figcaption class="absolute bottom-0 inset-x-0 bg-primary/90 p-4 text-xs tracking-wider uppercase text-primary-foreground/80 backdrop-blur-sm">
            {clinicContact.city} · {clinicContact.streetAddress}
          </figcaption>
        </figure>
      </div>
    </Container>
  </header>

  <!-- Trust & Reassurance Cards -->
  <section class="bg-background py-16 sm:py-20 lg:py-28" aria-labelledby="pediatric-trust-heading">
    <Container>
      <div class="max-w-2xl" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "pediatric.heroEyebrow")}
        </span>
        <h2 id="pediatric-trust-heading" class="mt-3 font-serif text-3xl font-medium tracking-tight text-foreground sm:text-4xl">
          {t(locale, "serviceDetail.clinicalTitle")}
        </h2>
      </div>

      <div class="mt-10 lg:mt-12">
        <TrustFeaturesGrid locale={locale} items={trustItems} />
      </div>
    </Container>
  </section>

  <!-- Pricing Section -->
  <section class="border-y border-border bg-muted/40 py-16 sm:py-20 lg:py-28" aria-labelledby="pediatric-pricing-heading">
    <Container>
      <div class="max-w-2xl" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "pediatric.pricingEyebrow")}
        </span>
        <h2 id="pediatric-pricing-heading" class="mt-3 font-serif text-3xl font-medium tracking-tight text-foreground sm:text-4xl">
          {t(locale, "pediatric.pricingTitle")}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
          {t(locale, "pediatric.pricingIntro")}
        </p>
      </div>

      <!-- Pricing Cards Grid -->
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        <!-- Consultation Card -->
        <article class="flex flex-col justify-between rounded-2xl border border-primary/20 bg-card p-6 shadow-sm transition-all hover:border-primary/50 hover:shadow-md sm:p-7">
          <div>
            <span class="text-xs font-semibold tracking-wider text-accent uppercase">
              {t(locale, "services.groupConsultations")}
            </span>
            <h3 class="mt-2 font-serif text-xl font-medium leading-snug text-foreground">
              {t(locale, "pediatric.itemInitial")}
            </h3>
          </div>
          <div class="mt-6 border-t border-border pt-4">
            <p class="font-serif text-3xl font-semibold tabular-nums text-primary">
              {formatMedicalPrice(700, locale)}
            </p>
          </div>
        </article>

        <!-- Follow-up Card -->
        <article class="flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-sm transition-all hover:border-primary/40 hover:shadow-md sm:p-7">
          <div>
            <span class="text-xs font-semibold tracking-wider text-muted-foreground uppercase">
              {t(locale, "services.groupConsultations")}
            </span>
            <h3 class="mt-2 font-serif text-xl font-medium leading-snug text-foreground">
              {t(locale, "pediatric.itemFollowup")}
            </h3>
          </div>
          <div class="mt-6 border-t border-border pt-4">
            <p class="font-serif text-3xl font-semibold tabular-nums text-primary">
              {formatMedicalPrice(600, locale)}
            </p>
          </div>
        </article>

        <!-- Autorefractometry Card -->
        <article class="flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-sm transition-all hover:border-primary/40 hover:shadow-md sm:p-7">
          <div>
            <span class="text-xs font-semibold tracking-wider text-muted-foreground uppercase">
              {t(locale, "services.groupDiagnostics")}
            </span>
            <h3 class="mt-2 font-serif text-xl font-medium leading-snug text-foreground">
              {t(locale, "pediatric.itemAutoref")}
            </h3>
          </div>
          <div class="mt-6 border-t border-border pt-4">
            <p class="font-serif text-3xl font-semibold tabular-nums text-primary">
              {formatMedicalPrice(200, locale)}
            </p>
          </div>
        </article>

        <!-- Glasses and Optical Fitting Card -->
        <article class="flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-sm transition-all hover:border-primary/40 hover:shadow-md sm:p-7">
          <div>
            <span class="text-xs font-semibold tracking-wider text-muted-foreground uppercase">
              {t(locale, "services.groupOptics")}
            </span>
            <h3 class="mt-2 font-serif text-xl font-medium leading-snug text-foreground">
              {t(locale, "pediatric.itemOptics")}
            </h3>
          </div>
          <div class="mt-6 border-t border-border pt-4">
            <p class="font-serif text-2xl font-semibold tabular-nums text-primary">
              {t(locale, "adult.packagePrice").replace("700", "300")}
            </p>
          </div>
        </article>
      </div>

      <!-- Kindergarten / School Vision Screening Feature Box -->
      <aside class="mt-8 overflow-hidden rounded-2xl border border-primary/20 bg-card p-6 shadow-xs sm:p-8" data-reveal>
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">
              <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {t(locale, "pediatric.screeningBadge")}
            </span>
            <h3 class="mt-3 font-serif text-2xl font-medium text-foreground">
              {t(locale, "pediatric.screeningTitle")}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground sm:text-base">
              {t(locale, "pediatric.screeningDesc")}
            </p>
          </div>

          <div class="flex shrink-0 flex-col sm:flex-row sm:items-center gap-4">
            <span class="font-serif text-lg font-medium text-primary sm:text-right">
              {t(locale, "pediatric.screeningPrice")}
            </span>
            <a
              class="focus-ring-primary inline-flex min-h-12 items-center justify-center rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
              href={appointmentHref}
            >
              {t(locale, "actions.bookShort")}
            </a>
          </div>
        </div>
      </aside>
    </Container>
  </section>

  <!-- Doctor Credibility Section -->
  <section class="bg-background py-16 sm:py-20 lg:py-28" aria-label={t(locale, "about.doctorEyebrow")}>
    <Container>
      <DoctorLeadCard locale={locale} approachKey="doctor.pediatricApproach" />
    </Container>
  </section>

  <!-- FAQ Section with Schema.org JSON-LD -->
  <section class="border-t border-border bg-muted/30 py-16 sm:py-20 lg:py-28" aria-label={t(locale, "pediatric.faqTitle")}>
    <Container>
      <ServiceFaqAccordion
        locale={locale}
        eyebrowKey="pediatric.faqEyebrow"
        titleKey="pediatric.faqTitle"
        faqs={faqs}
      />
    </Container>
  </section>

  <!-- Final Booking Section with Integrated AppointmentForm -->
  <section
    id="appointment"
    class="scroll-mt-20 border-t border-border bg-background py-20 sm:py-24 lg:py-32"
    aria-labelledby="pediatric-booking-title"
  >
    <Container class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
      <div class="min-w-0 lg:col-span-5 lg:pt-8" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "pediatric.finalEyebrow")}
        </span>
        <h2 id="pediatric-booking-title" class="mt-4 font-serif text-3xl font-medium leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          {t(locale, "pediatric.finalTitle")}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-muted-foreground">
          {t(locale, "pediatric.finalIntro")}
        </p>

        <div class="mt-8 border-t border-border pt-6">
          <p class="text-xs uppercase tracking-wider text-muted-foreground">
            {t(locale, "contacts.telephoneLabel")}:
          </p>
          <a
            class="mt-2 inline-flex items-center gap-2 font-serif text-xl font-semibold text-primary transition-colors hover:text-accent sm:text-2xl"
            href={clinicContact.phoneHref}
            aria-label={callAriaLabel}
          >
            <svg class="size-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>{clinicContact.phoneDisplay}</span>
          </a>
        </div>
      </div>

      <div class="min-w-0 lg:col-span-7 xl:pl-8">
        <AppointmentForm locale={locale} />
      </div>
    </Container>
  </section>
</BaseLayout>
