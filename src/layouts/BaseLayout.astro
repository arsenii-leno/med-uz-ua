---
import "../styles/global.css";
import CartDrawer from "../components/commerce/CartDrawer.astro";
import MobileActionBar from "../components/clinic/MobileActionBar.astro";
import SiteFooter from "../components/clinic/SiteFooter.astro";
import SiteHeader from "../components/clinic/SiteHeader.astro";
import InteractionController from "../components/ui/InteractionController.astro";
import AnalyticsConsent from "../components/analytics/AnalyticsConsent.astro";
import {
  localeFromPath,
  locales,
  localizePath,
  stripLocalePrefix,
  t,
  type Locale,
} from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  locale?: Locale;
  robots?: string;
  image?: string | URL;
}

const {
  title,
  description,
  canonical,
  locale: localeProp,
  robots = "index, follow",
  image = "/logo_oft1.png",
} = Astro.props;

const locale = localeProp ?? localeFromPath(Astro.url.pathname);
const canonicalUrl = new URL(
  canonical ?? Astro.url.pathname,
  Astro.site ?? Astro.url,
).toString();
const canonicalRoutePath = stripLocalePrefix(Astro.url.pathname);
const alternateLocaleUrls = locales.map((alternateLocale) => ({
  locale: alternateLocale,
  url: new URL(
    localizePath(canonicalRoutePath, alternateLocale),
    Astro.site ?? Astro.url,
  ).toString(),
}));
const defaultLocaleUrl = new URL(
  localizePath(canonicalRoutePath, "uk"),
  Astro.site ?? Astro.url,
).toString();

const ogImageUrl = new URL(image, Astro.site ?? Astro.url).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalClinic",
      "@id": "https://med.uz.ua/#clinic",
      "name": "Європейська офтальмологічна клініка",
      "url": "https://med.uz.ua",
      "logo": new URL("/logo_oft1.png", Astro.site ?? Astro.url).toString(),
      "image": new URL("/logo_oft1.png", Astro.site ?? Astro.url).toString(),
      "telephone": "+380997770758",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "вулиця Юрія Гойди, 10А",
        "addressLocality": "Ужгород",
        "addressRegion": "Закарпатська область",
        "postalCode": "88000",
        "addressCountry": "UA"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 48.6277,
        "longitude": 22.2988
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "sameAs": [
        "https://www.facebook.com/likarmiroslava/",
        "https://www.instagram.com/oftalmolog_uzhgorod/",
        "https://www.tiktok.com/@oftalmologuzhhorodclinic"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Офтальмологічні послуги та Оптика",
        "url": new URL("/services/", Astro.site ?? Astro.url).toString()
      }
    },
    {
      "@type": "Optician",
      "@id": "https://med.uz.ua/#optician",
      "name": "Оптичний салон та магазин Європейської офтальмології",
      "url": new URL("/shop/", Astro.site ?? Astro.url).toString(),
      "telephone": "+380997770758",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "вулиця Юрія Гойди, 10А",
        "addressLocality": "Ужгород",
        "postalCode": "88000",
        "addressCountry": "UA"
      }
    }
  ]
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <!-- Favicon & Brand Icons (Optimized for Google Favicon Bot & Apple) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>

    <slot name="canonical">
      <link rel="canonical" href={canonicalUrl} />
    </slot>
    {
      alternateLocaleUrls.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.locale}
          href={alternate.url}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org Knowledge Graph -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Attribution Capture & Google Consent Mode v2 (Must execute before GTM loads) -->
    <script is:inline>
      (function() {
        // 1. Capture ad identifiers & UTM parameters from URL into sessionStorage immediately
        try {
          var params = new URLSearchParams(window.location.search);
          var keys = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
          for (var i = 0; i < keys.length; i++) {
            var val = params.get(keys[i]);
            if (val) {
              window.sessionStorage.setItem('med_' + keys[i], val);
            }
          }
        } catch (e) {}

        // 2. Initialize dataLayer and global gtag function
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;

        // 3. Google Consent Mode v2: initialize defaults
        var consentKey = 'meduzua:analytics-consent:v2';
        var stored = null;
        try {
          var raw = window.localStorage.getItem(consentKey);
          if (raw) stored = JSON.parse(raw);
        } catch (e) {}

        var defaultConsent = {
          'analytics_storage': 'granted',
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted'
        };

        if (stored && stored.version === 2) {
          defaultConsent.analytics_storage = stored.analytics ? 'granted' : 'denied';
          defaultConsent.ad_storage = stored.advertising ? 'granted' : 'denied';
          defaultConsent.ad_user_data = stored.advertising ? 'granted' : 'denied';
          defaultConsent.ad_personalization = stored.advertising ? 'granted' : 'denied';
        }

        gtag('consent', 'default', defaultConsent);
      })();
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-K96GCCJ5');
    </script>
    <!-- End Google Tag Manager -->

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K96GCCJ5" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-primary-foreground focus:shadow-xl focus:outline-none"
      href="#main-content"
    >
      {t(locale, "a11y.skipToContent")}
    </a>
    <SiteHeader locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <MobileActionBar locale={locale} />
    <CartDrawer locale={locale} />
    <InteractionController />
    <AnalyticsConsent locale={locale} />
  </body>
</html>
